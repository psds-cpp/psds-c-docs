{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "deny"
    }
  ]
}
