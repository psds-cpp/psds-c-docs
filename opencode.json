{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "product-manager",
  "agents": {
    "tech-writer": {
      "mode": "subagent",
      "permissions": [
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "webfetch",  "resource": "*", "effect": "allow" },
        { "action": "shell",     "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git push*",   "effect": "deny" },
        { "action": "shell", "resource": "git reset*",  "effect": "deny" },
        { "action": "edit",      "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/*",   "effect": "deny" },
        { "action": "edit", "resource": "opencode.json", "effect": "deny" },
        { "action": "edit", "resource": "AGENTS.md",     "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" }
      ]
    },
    "latex-designer": {
      "mode": "subagent",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit",  "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git push*",   "effect": "deny" },
        { "action": "shell", "resource": "git reset*",  "effect": "deny" },
        { "action": "edit", "resource": ".opencode/*",   "effect": "deny" },
        { "action": "edit", "resource": "opencode.json", "effect": "deny" },
        { "action": "edit", "resource": "AGENTS.md",     "effect": "deny" }
      ]
    },
    "product-manager": {
      "mode": "primary",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "shell",    "resource": "*", "effect": "allow" },
        { "action": "shell",    "resource": "git push*",   "effect": "deny" },
        { "action": "shell",    "resource": "git reset*",  "effect": "deny" },
        { "action": "shell",    "resource": "git commit*", "effect": "allow" },
        { "action": "edit",     "resource": "*", "effect": "deny" },
        { "action": "edit",     "resource": ".opencode/*",   "effect": "allow" },
        { "action": "edit",     "resource": "opencode.json", "effect": "allow" },
        { "action": "edit",     "resource": "AGENTS.md",     "effect": "allow" }
      ]
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "deny"
    }
  ]
}
